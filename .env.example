# Public application configuration (safe to commit; no secrets).
# Copy this file to .env.local and replace the placeholders with your project values.
# Use the Supabase publishable (anon) key only. Never put a service-role or secret key here.

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tenant routing (optional; default is path mode: every company site lives at <SITE_URL>/s/<slug>).
# Subdomain mode (<slug>.<PLATFORM_DOMAIN> + verified custom domains) needs a bought domain, wildcard DNS and a wildcard certificate.
# Local test: TENANT_MODE=subdomain, PLATFORM_DOMAIN=localtest.me, NEXT_PUBLIC_SITE_URL=http://localtest.me:3000
TENANT_MODE=path
# PLATFORM_DOMAIN=malaky.app
# Extra hosts that must keep serving the platform app in subdomain mode (preview deployments, localhost), comma separated:
# PLATFORM_EXTRA_HOSTS=guber-six.vercel.app

# Captcha (P6a). Optional until a super admin turns enforcement on; see DEPLOYMENT.md 2.1. Secrets go in the host dashboard, never here.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# CAPTCHA_PASS_SECRET=

# Auth captcha (P6c): 'on' ONLY together with Supabase Dashboard > Authentication > Attack Protection (Turnstile). See DEPLOYMENT.md 2.2.
# NEXT_PUBLIC_AUTH_CAPTCHA=off
